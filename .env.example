# Base URL REST API backend (Express + Prisma + PostGIS).
# Nilai di bawah sudah bisa langsung dipakai (BE publik, sama dengan yang
# di-hit oleh https://rongsokin.vercel.app) — tinggal copy jadi .env.local.
NEXT_PUBLIC_API_URL=https://be-rongsokin.hallojanu.xyz/api/v1

# URL Socket.IO untuk notifikasi & live tracking real-time
NEXT_PUBLIC_SOCKET_URL=https://be-rongsokin.hallojanu.xyz

# OCR KTP saat KYC (opsional). Tanpa ini otomatis fallback ke Tesseract.js,
# jadi aplikasi tetap jalan tanpa key ini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
